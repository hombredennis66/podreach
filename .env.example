# Spotify Web API (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Patched Spotizerr Phoenix instance.
# Episode automation in this repo depends on the owned fork in inspo/spotizerr-phoenix.
SPOTIZERR_URL=http://localhost:7171
SPOTIZERR_TOKEN=
# Host path for the Phoenix downloads volume (maps to /app/downloads in the container).
# Required for exact-file handoff after episode download.
SPOTIZERR_DOWNLOADS_DIR=

# Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key
